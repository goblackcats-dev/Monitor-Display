# Install: sudo cp scripts/monitor-display.service /etc/systemd/system/ && sudo systemctl enable --now monitor-display
# Edit User and paths first.
[Unit]
Description=Monitor Display backend
After=network-online.target
Wants=network-online.target

[Service]
User=CHANGE_ME
WorkingDirectory=/home/CHANGE_ME/Monitor-Display
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
