# Copy to .env and fill in what you use. Everything is optional.
PORT=8787

# --- Spotify (Premium required for playback control) ---
# Create an app at https://developer.spotify.com/dashboard
# Redirect URI to register: http://127.0.0.1:8787/auth/spotify/callback
SPOTIFY_CLIENT_ID=

# --- Claude Code (reads local JSONL logs) ---
# Default: ~/.claude/projects. Point at a synced copy of your work laptop's logs
# (several dirs allowed, separated by ':').
CLAUDE_LOG_DIRS=
# Optional token budget for the 5h window, to turn the ring into % of budget.
CLAUDE_5H_LIMIT_TOKENS=
CLAUDE_WEEK_LIMIT_TOKENS=

# --- Optional API spend (admin keys) ---
ANTHROPIC_ADMIN_KEY=
OPENAI_ADMIN_KEY=

# --- To-do list written by a Claude chat (MCP connector) ---
# Secret path segment protecting /mcp/<token>. Leave empty to auto-generate (printed at startup).
MCP_TOKEN=

# --- Weather (Open-Meteo, free, no key): today's high / low / symbol in the header ---
# Either a city (add the state or country to pick the right one) or exact coordinates.
WEATHER_CITY=
WEATHER_LAT=
WEATHER_LON=
# fahrenheit (default) or celsius
WEATHER_UNITS=

# --- Next calendar event (one line under the clock) ---
# Google Calendar > Settings > your calendar > Integrate calendar > "Secret address in iCal format".
# That URL is a password for your calendar: enter it with `bash scripts/set-env.sh CALENDAR_ICS_URL`.
CALENDAR_ICS_URL=

# Show fake data (also: npm run demo)
DEMO=
